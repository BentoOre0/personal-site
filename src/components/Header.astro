---
import Loader from './Loader.astro';
import { IDENTITY } from '../data/profile';

const path = Astro.url.pathname;
const isHome = path === '/';
const isNotes = path.startsWith('/blog');
---

<header>
	<div class="sheet bar">
		<a class="mark" href="/">{IDENTITY.name}</a>
		<nav aria-label="Sections">
			<a href="/" aria-current={isHome ? 'page' : undefined}>Home</a>
			<a href="/blog" aria-current={isNotes ? 'page' : undefined}>Blog</a>
		</nav>
	</div>
</header>

<Loader />

<style>
	header {
		border-bottom: var(--hairline) solid var(--rule);
	}

	.bar {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--s-4);
		padding-block: var(--s-3);
	}

	.mark {
		font-size: var(--t-xs);
		font-weight: 600;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--ink);
		text-decoration: none;
		transition: color 120ms ease-out;
	}

	@media (hover: hover) {
		.mark:hover,
	.mark:active {
			color: var(--accent);
	
		}
	}

	nav {
		display: flex;
		gap: var(--s-4);
	}

	nav a {
		font-size: var(--t-xs);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
		text-decoration: none;
		padding-bottom: var(--s-1);
		border-bottom: var(--hairline) solid transparent;
		transition: color 120ms ease-out;
	}

	@media (hover: hover) {
		/* Hover, pressed and current all read in the accent, the same as the
	   wordmark — the colour tracks the nav as one behaviour. */
	nav a:hover,
	nav a:active {
			color: var(--accent);
	
		}
	}

	nav a[aria-current='page'] {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}

	@media (max-width: 30rem) {
		.bar {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--s-2);
		}
	}
</style>
