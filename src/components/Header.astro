---
import Loader from './Loader.astro';
import { IDENTITY } from '../data/profile';

const path = Astro.url.pathname;
const isHome = path === '/';
const isNotes = path.startsWith('/blog');
---

<header>
	<a class="skip" href="#content">Skip to content</a>
	<div class="sheet bar">
		<a class="mark" href="/">{IDENTITY.name}</a>
		<nav aria-label="Sections">
			<a href="/" aria-current={isHome ? 'page' : undefined}>Home</a>
			<a href="/blog" aria-current={isNotes ? 'page' : undefined}>Blog</a>
		</nav>
	</div>
</header>

<Loader />

<style>
	header {
		border-bottom: var(--hairline) solid var(--rule);
	}

	/* The keyboard reader's way past the nav. Off-screen until focused,
	   which is the point: it is the only control on the site that exists
	   for one input method and has to stay invisible to the others.

	   Not `display: none`, which would take it out of the tab order and
	   leave the link that is supposed to be reachable unreachable. Moved
	   out of the viewport instead, and moved back on focus.

	   Set like every other handle on the sheet, mono at 14px, and given a
	   hairline box so it reads as a thing that just appeared rather than
	   as text loose on the paper. `#content` is on the `<main>` of every
	   page this header serves; if a new page adds a `<main>`, it needs the
	   id too.

	   `z-index: 300` clears the loading sheet, which covers the viewport
	   at 200 while the page underneath is already interactive. Without it
	   a reader who tabs during the hold would focus a link drawn behind an
	   opaque panel. */
	.skip {
		position: absolute;
		left: var(--s-3);
		top: var(--s-3);
		z-index: 300;
		transform: translateY(calc(-100% - var(--s-5)));
		padding: var(--s-2) var(--s-3);
		background: var(--paper);
		border: var(--hairline) solid var(--rule-strong);
		border-radius: 2px;
		font-family: var(--font-geist-mono);
		font-size: var(--t-xs);
		letter-spacing: 0.02em;
		text-decoration: none;
		transition: transform 120ms ease-out;
	}

	.skip:focus-visible {
		transform: translateY(0);
	}

	/* It still has to arrive, just without the travel. The blanket rule in
	   `global.css` already crushes this to 0.01ms; this says so locally so
	   the intent survives that rule being scoped later. */
	@media (prefers-reduced-motion: reduce) {
		.skip {
			transition: none;
		}
	}

	.bar {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--s-4);
		padding-block: var(--s-3);
	}

	.mark {
		font-size: var(--t-xs);
		font-weight: 600;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--ink);
		text-decoration: none;
		transition: color 120ms ease-out;
	}

	@media (hover: hover) {
		.mark:hover {
			color: var(--accent);
		}
	}

	/* Outside the hover query on purpose: a tap must acknowledge itself,
	   and a touch device has no hover to fall back on. */
	.mark:active {
		color: var(--accent);
	}

	nav {
		display: flex;
		gap: var(--s-4);
	}

	nav a {
		font-size: var(--t-xs);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
		text-decoration: none;
		padding-bottom: var(--s-1);
		border-bottom: var(--hairline) solid transparent;
		transition: color 120ms ease-out;
	}

	/* Hover, pressed and current all read in the accent, the same as the
	   wordmark, the colour tracks the nav as one behaviour. */
	@media (hover: hover) {
		nav a:hover {
			color: var(--accent);
		}
	}

	nav a:active {
		color: var(--accent);
	}

	nav a[aria-current='page'] {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}

	@media (max-width: 30rem) {
		.bar {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--s-2);
		}
	}

	/* Windows High Contrast repaints `transparent` borders to
	   `CanvasText`. A resting nav item carries
	   `border-bottom: 1px solid transparent` to reserve the space, so in
	   that mode every item drew the underline that marks the current
	   page and `aria-current` stopped meaning anything.

	   Border *style* is not overridden the way colour is, so the state is
	   carried by style here. This has to live in this component: Astro
	   scopes these selectors with an attribute, and a bare `nav a` in
	   `global.css` cannot outrank them however late it is loaded. The
	   space is still reserved, because `none` and `solid` at the same
	   width do not change the box. */
	@media (forced-colors: active) {
		nav a {
			border-bottom-style: none;
		}

		nav a[aria-current='page'] {
			border-bottom-style: solid;
		}
	}

	/* On paper the wordmark is the document's title line rather than a
	   link home, so it sets on its own and the nav that stacked under it
	   at 30rem is gone. */
	@media print {
		.bar {
			display: block;
			padding-block: 0 var(--s-2);
		}
	}
</style>

<script>
	/* Folded evidence has to print.

	   A credential's supporting quotations live in a closed `<details>`,
	   which is the right proportion on screen and the wrong one on paper:
	   a printout cannot be clicked, so a folded quotation is not folded,
	   it is missing. Those passages are the strongest verifiable material
	   on the page and the likeliest reason to print it at all.

	   CSS cannot do this. A closed `<details>` hides its content through
	   the user agent's own shadow tree rather than through a property a
	   stylesheet can reach, so the only reliable opener is the element's
	   `open` attribute. Which ones were already open is recorded and put
	   back afterwards, so printing does not silently rearrange the page
	   the reader is still looking at.

	   `beforeprint` covers the print dialog and Save as PDF in every
	   engine that fires it; the matchMedia branch is Safari, which has
	   historically fired the media query and not the events. Both paths
	   run the same two functions and are safe to run twice. */
	const opened = new WeakSet<HTMLDetailsElement>();

	const unfold = () => {
		document.querySelectorAll('details').forEach((d) => {
			if (d.open) return;
			opened.add(d);
			d.open = true;
		});
	};

	const refold = () => {
		document.querySelectorAll('details').forEach((d) => {
			if (!opened.has(d)) return;
			opened.delete(d);
			d.open = false;
		});
	};

	window.addEventListener('beforeprint', unfold);
	window.addEventListener('afterprint', refold);

	const printing = window.matchMedia('print');
	printing.addEventListener('change', (event) => (event.matches ? unfold() : refold()));
</script>
