---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
/* The default link-preview card, 1200x630. Rendered from the site's own
   parts rather than drawn: the loading screen's figure, the name and the
   tagline, in Geist, on the loader's ink ground. Someone who clicks the
   link lands on that same loading screen, so the card and the first frame
   of the site are the same picture. It replaced `blog-placeholder-1.jpg`,
   Astro stock art that had been the preview for every page on the site.
   **It is sized for a phone feed, not for a 1200px canvas.** LinkedIn
   renders a card around 340 to 400px wide, so everything on it divides by
   three: the first version set the line under the name at 28px and a
   footer at 19px, which land at 9px and 6px on a phone and were reported
   as unreadable. The floor is about 42px in the source, which is 14px at
   400px wide. The name is 86px and the line is 46px. The footer is gone
   because LinkedIn already prints the domain under the card, so repeating
   it inside cost the rest of the card its size.

   Regenerate it the way it was made: an HTML card served from `dist/`,
   captured at 1200x630 with `--force-device-scale-factor=2` and
   downsampled. Check it by shrinking the result to 380px wide and reading
   it, which is the size it is actually judged at. */
import FallbackImage from '../assets/og-card.png';
import { SITE_TITLE } from '../consts';
import { SEO } from '../data/profile';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	/* `article` on a blog post, `website` everywhere else. */
	type?: 'website' | 'article';
	/* Keep this page out of search results. It stays on the site, in the nav
	   and in every link that points at it; only the index drops it. Used for
	   the Astro demo posts, which are Lorem ipsum shipped with the template
	   and identical on thousands of other sites. Real posts leave it unset. */
	noindex?: boolean;
}

// Astro.site can be missing (stale dev server, or config without `site`).
// A missing canonical is recoverable; a thrown URL takes the whole page down.
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const rssURL = Astro.site ? new URL('rss.xml', Astro.site) : undefined;

const { title, description, image = FallbackImage, type = 'website', noindex = false } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
{
	rssURL && (
		<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={rssURL} />
	)
}
<meta name="generator" content={Astro.generator} />

<!-- Indexing. `follow` is deliberate: a noindexed page is still a real page,
     and the links out of it should still count. -->
{noindex && <meta name="robots" content="noindex, follow" />}
{
	SEO.googleSiteVerification && (
		<meta name="google-site-verification" content={SEO.googleSiteVerification} />
	)
}

<ClientRouter />

<Font cssVariable="--font-geist" preload />
<Font cssVariable="--font-geist-mono" preload />

<!-- Canonical URL -->
{canonicalURL && <link rel="canonical" href={canonicalURL} />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook. Twitter reads og:title, og:description and
     og:image, so only the card type needs restating below. -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={canonicalURL ?? Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />
<meta property="og:image:width" content={String(image.width)} />
<meta property="og:image:height" content={String(image.height)} />
<meta property="og:image:alt" content={description} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
