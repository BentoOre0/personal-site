---
interface Props {
	tags: string[];
	label?: string;
}

const { tags, label } = Astro.props;
---

{
	tags.length > 0 && (
		<ul class="tags" aria-label={label ?? 'Tags'}>
			{tags.map((tag) => (
				<li>
					<a class="chip" href={`/blog/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-2);
		list-style: none;
		margin: 0;
		padding: 0;
	}
</style>
