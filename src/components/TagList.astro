---
interface Props {
	tags: string[];
	label?: string;
}

const { tags, label } = Astro.props;
---

{
	tags.length > 0 && (
		<ul class="tags" aria-label={label ?? 'Tags'}>
			{tags.map((tag) => (
				<li>
					<a href={`/blog/tags/${tag}/`}>{tag}</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-2);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.tags a {
		display: inline-block;
		font-family: var(--font-geist-mono);
		font-size: var(--t-xs);
		line-height: 1.3;
		color: var(--accent);
		text-decoration: none;
		padding: 2px var(--s-2);
		border: var(--hairline) solid color-mix(in srgb, var(--accent) 35%, transparent);
		transition:
			color 120ms ease-out,
			border-color 120ms ease-out,
			background-color 120ms ease-out;
	}

	.tags a:hover {
		color: color-mix(in srgb, var(--accent) 72%, #000);
		border-color: var(--accent);
		background: color-mix(in srgb, var(--accent) 7%, transparent);
	}
</style>
