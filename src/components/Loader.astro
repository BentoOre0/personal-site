---
/*
  The loading screen. Ink ground, white line art, red music notes.

  An all-red ground was tried and rejected: the accent marks disappear
  into it. Ink keeps the Z's and the music notes as the only colour on
  the screen. Three layers, each on its own clock, the figure trots,
  the notes bob against it, the Z's jitter.

  This is the site's second piece of motion and the only autonomous one
  besides the typed tagline. A loading indicator that does not move is
  not a loading indicator, so it earns the exception, and it is off
  entirely under prefers-reduced-motion.
*/
---

<div id="loader" class="loader" role="status" aria-live="polite">
	<div class="stage">
		<img
			class="art body"
			src="/loader/jeremote-body.png"
			width="485"
			height="568"
			fetchpriority="high"
			decoding="sync"
			alt=""
		/>
		<img class="art notes" src="/loader/jeremote-notes.png" width="485" height="568" alt="" />
		<img class="art zzz" src="/loader/jeremote-zzz.png" width="485" height="568" alt="" />
	</div>
	<p class="label">Loading</p>
</div>

<noscript>
	<style>
		#loader {
			display: none !important;
		}
	</style>
</noscript>

<style>
	.loader {
		position: fixed;
		inset: 0;
		z-index: 200;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--s-4);
		padding: max(var(--s-4), env(safe-area-inset-top)) var(--s-4)
			max(var(--s-4), env(safe-area-inset-bottom));
		background: var(--ink);
		transform: translate3d(0, 0, 0);
		visibility: visible;
		/* The sheet is pulled off the page rather than dissolved, a fade
		   leaves the art hanging half-visible over the content behind it. */
		transition:
			transform 480ms cubic-bezier(0.66, 0, 0.2, 1),
			visibility 0s linear 480ms;
		/* **This is the element that moves**, and it was the one thing not
		   promoted. The children were given `will-change` and this was not,
		   so a phone was repainting a full-viewport opaque rectangle every
		   frame of the exit instead of letting the compositor slide a
		   finished layer. `translate3d` rather than `translateY` for the
		   same reason on older iOS. */
		will-change: transform;
		backface-visibility: hidden;
		/* Failsafe: if the script never runs, the overlay still leaves
		   rather than sealing the page shut. */
		animation: loader-failsafe 0s linear 6s forwards;
	}

	.loader.is-done {
		transform: translate3d(0, -100%, 0);
		visibility: hidden;
		pointer-events: none;
	}

	@keyframes loader-failsafe {
		to {
			transform: translate3d(0, -100%, 0);
			visibility: hidden;
			pointer-events: none;
		}
	}

	/* Used when a client-side navigation swaps in fresh markup: the
	   overlay must vanish without replaying. */
	.loader.is-instant {
		transition: none;
	}

	.stage {
		position: relative;
		/* Bounded by height as well as width: the art is taller than it is
		   wide, and a landscape phone is short, not narrow. */
		width: min(clamp(180px, 30vw, 260px), 47vh);
		aspect-ratio: 485 / 568;
		animation: trot 660ms ease-in-out infinite;
		/* Three transform animations run nested here, the stage and the two
		   layers inside it. Without a promotion hint a phone composites them
		   on the main thread every frame and the whole loader stutters. */
		will-change: transform;
	}

	.art {
		position: absolute;
		inset: 0;
		width: 100%;
		height: auto;
	}

	.notes {
		animation: notes 900ms ease-in-out infinite;
		transform-origin: 78% 44%;
		will-change: transform, opacity;
	}

	.zzz {
		animation: zzz 420ms steps(2, jump-none) infinite;
		transform-origin: 66% 14%;
		will-change: transform;
	}

	/* Nothing inside moves while the sheet slides off. The exit is 480ms of
	   the compositor moving one layer; leaving three nested animations
	   running underneath it is the most expensive frame on the site, on the
	   slowest device, at the moment it is most visible. */
	.loader.is-done .stage,
	.loader.is-done .notes,
	.loader.is-done .zzz {
		animation: none;
	}

	.label {
		margin: 0;
		font-family: var(--font-geist-mono);
		font-size: var(--t-xs);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--paper);
		opacity: 0.6;
	}

	@keyframes trot {
		0%,
		100% {
			transform: translateY(0) rotate(-1.6deg);
		}
		50% {
			transform: translateY(-9px) rotate(1.6deg);
		}
	}

	@keyframes notes {
		0%,
		100% {
			transform: translateY(0) rotate(-4deg);
			opacity: 0.75;
		}
		50% {
			transform: translateY(-7px) rotate(6deg);
			opacity: 1;
		}
	}

	@keyframes zzz {
		0% {
			transform: translate(-1.5px, 1px) rotate(-2.5deg);
		}
		33% {
			transform: translate(2px, -1px) rotate(2deg);
		}
		66% {
			transform: translate(-1px, -1.5px) rotate(-1deg);
		}
		100% {
			transform: translate(1px, 1.5px) rotate(2.5deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.stage,
		.notes,
		.zzz {
			animation: none;
		}
		.loader {
			transition: none;
		}
	}
</style>

<script>
	// Minimum time on screen for a full load or a refresh. The site itself
	// is ready in a fraction of this, so it is a deliberate hold, not a wait.
	const HOLD = 1400;

	const el = () => document.getElementById('loader');
	let swapped = false;

	/* Fired the moment the overlay starts leaving, so animations behind it
	   can hold off. Anything listening must also have its own failsafe: if
	   this script never runs, the event never comes. */
	const announce = () => document.dispatchEvent(new CustomEvent('loader:done'));

	const dismiss = (loader: HTMLElement, instant = false) => {
		if (instant) {
			loader.classList.add('is-instant', 'is-done');
			announce();
			return;
		}
		/* Two frames before the slide starts. The class change is what first
		   reveals the page underneath, and that reveal is the most expensive
		   paint on the site: a long, image-heavy homepage, first paint, on a
		   phone. Landing it inside the same frame that begins the transition
		   spends that cost on frame one of the animation, which is exactly
		   where a stutter is most visible. Waiting two frames lets the paint
		   settle and starts the slide on a clean boundary. */
		requestAnimationFrame(() =>
			requestAnimationFrame(() => {
				loader.classList.add('is-done');
				announce();
			}),
		);
	};

	// A client-side navigation brings in fresh markup with the overlay
	// visible. Kill it immediately, only a full load or an explicit
	// replay should show the loading screen.
	document.addEventListener('astro:after-swap', () => {
		swapped = true;
		const loader = el();
		if (loader) dismiss(loader, true);
	});

	document.addEventListener('astro:page-load', () => {
		const loader = el();
		if (!loader) return;
		if (swapped) {
			dismiss(loader, true);
			return;
		}
		const start = performance.now();
		const finish = () =>
			setTimeout(() => dismiss(loader), Math.max(0, HOLD - (performance.now() - start)));
		if (document.readyState === 'complete') finish();
		else window.addEventListener('load', finish, { once: true });
	});

	// The wordmark reloads the page immediately. It deliberately bypasses
	// ClientRouter: a client-side swap would hide the loader instantly,
	// and the point of clicking the name is to watch the loading screen.
	document.addEventListener('click', (event) => {
		const mark = (event.target as HTMLElement)?.closest?.('a.mark') as HTMLAnchorElement | null;
		if (!mark) return;
		const e = event as MouseEvent;
		if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
		event.preventDefault();
		window.location.href = mark.href;
	});
</script>
