---
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import PostList from '../../../components/PostList.astro';
import TagFilter from '../../../components/TagFilter.astro';
import { getSortedPosts, postsForTag, getTagCounts } from '../../../lib/posts';
import { SITE_TITLE } from '../../../consts';

export async function getStaticPaths() {
	const posts = await getSortedPosts();

	// The filter bar carries every tag, not just this page's, so a reader can
	// move between tags without going back to /blog first. It is identical on
	// every archive, so it is built once here rather than recomputed inside
	// each page, getStaticPaths runs once, the component body runs per tag.
	const tags = getTagCounts(posts);

	return tags.map(([tag]) => ({
		params: { tag },
		props: { posts: postsForTag(posts, tag), tags, total: posts.length },
	}));
}

const { tag } = Astro.params;
const { posts, tags, total } = Astro.props;
const count = posts.length;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${tag}, ${SITE_TITLE}`}
			description={`Posts tagged ${tag}.`}
		/>
	</head>
	<body>
		<Header />
		<main class="sheet">
			<div class="head">
				<p class="legend"><a href="/blog">← All posts</a></p>
				<h1>{tag}</h1>
				<p class="lede">{count} {count === 1 ? 'post' : 'posts'}</p>
			</div>

			<TagFilter tags={tags} total={total} current={tag} />

			<PostList posts={posts} />
		</main>
		<Footer />
	</body>
</html>

<style>
	.head {
		padding-block: var(--s-6) var(--s-5);
		max-width: var(--measure);
	}

	.head .legend {
		margin: 0 0 var(--s-3) 0;
	}

	/* The same back link as the one on a post, and it is styled the same
	   way: accent, underlined at rest. It was muted with the underline
	   suppressed, so the identical control read as a link on one page and
	   as grey prose on the other, and on a phone the second version had no
	   cue at all. */
	.head .legend a {
		text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
	}

	@media (hover: hover) {
		.head .legend a:hover {
			text-decoration-color: var(--accent);
		}
	}

	h1 {
		font-family: var(--font-geist-mono);
		letter-spacing: -0.02em;
	}

	.lede {
		font-size: var(--t-xs);
		color: var(--muted);
		margin: var(--s-3) 0 0 0;
		font-family: var(--font-geist-mono);
	}

</style>
