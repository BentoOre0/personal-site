---
import { Image } from 'astro:assets';
import avatar from '../../assets/avatar.png';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/PostList.astro';
import TagFilter from '../../components/TagFilter.astro';
import { getSortedPosts, getTagCounts } from '../../lib/posts';
import { SITE_TITLE } from '../../consts';

const posts = await getSortedPosts();

// Tag counts drive the filter bar. Each chip is a plain link to the static
// tag page, so filtering needs no JavaScript and the URL is always honest.
const tags = getTagCounts(posts);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Blog, ${SITE_TITLE}`}
			description="Notes on things built, measured, and got working."
		/>
	</head>
	<body>
		<Header />
		<main class="sheet">
			<div class="head">
				<Image class="avatar" src={avatar} width={192} densities={[1, 2]} loading="eager" alt="" />
				<div class="head-text">
					<h1>Blog</h1>
					<p class="lede">Notes on things built, measured, and got working.</p>
				</div>
			</div>

			<TagFilter tags={tags} total={posts.length} />

			{
				posts.length === 0 && (
					<div class="plate">
						<span class="legend">No entries</span>
						<span class="plate-spec">
							This section is unpopulated. Entries appear here newest first, each with
							a title, a one-line summary, its tags and a date.
						</span>
					</div>
				)
			}

			<PostList posts={posts} />
		</main>
		<Footer />

	</body>
</html>

<style>
	/* The drawing sits at a fixed size, vertically centred against the title
	   and its subtext to the right. No rule beneath, nothing that resizes. */
	.head {
		display: flex;
		align-items: center;
		gap: var(--s-4);
		padding-block: var(--s-7) var(--s-6);
		/* Text caps at the same measure the tag archives use. */
		max-width: var(--measure);
	}

	.avatar {
		width: 96px;
		height: auto;
		flex: none;
		/* Drawn on white, so it sits on the paper without a frame. */
		mix-blend-mode: multiply;
	}

	.head-text {
		min-width: 0;
	}

	.head-text h1 {
		margin: 0;
	}

	.lede {
		font-size: var(--t-md);
		color: var(--muted);
		margin: var(--s-2) 0 0 0;
		max-width: 46ch;
	}

	@media (max-width: 40rem) {
		.head {
			gap: var(--s-3);
			padding-block: var(--s-6) var(--s-5);
		}

		.avatar {
			width: 72px;
		}

	}
</style>
