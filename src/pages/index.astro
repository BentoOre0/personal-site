---
import { Image } from 'astro:assets';
import discipline from '../assets/discipline-crop2.png';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Figure from '../components/Figure.astro';
import Icon from '../components/Icon.astro';
import PersonLd from '../components/PersonLd.astro';
import SectionHead from '../components/SectionHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { CREDENTIALS, IDENTITY, PROJECTS, REVISION, SPECS } from '../data/profile';

/* The homepage's sections, in the order they appear. §N is derived from this
   list, so inserting a section renumbers everything after it automatically.
   The numbers used to be literal text in three places; a missed renumber gave
   the page two §3s with a green build and no warning.

   `id`s are permalink targets and are historical, `features` renders as
   "Credentials", `specs` as "Details", `work` as "Projects". Do not rename
   them; someone may have saved a link. */
const SECTIONS = [
	{ id: 'features', title: 'Credentials' },
	{ id: 'specs', title: 'Details' },
	{ id: 'work', title: 'Projects' },
] as const;

const section = (id: (typeof SECTIONS)[number]['id']) => {
	const i = SECTIONS.findIndex((s) => s.id === id);
	return { ...SECTIONS[i], n: i + 1 };
};

/* Figure numbers count only the projects that actually carry a figure, keyed
   by the project's index. Numbering off the project index instead skips a
   number the moment a figure-less project sits anywhere but last; it lined
   up only because the one entry without a figure happened to be at the end. */
const figureNumber = new Map<number, number>();
PROJECTS.forEach((p, i) => {
	if (p.figure) figureNumber.set(i, figureNumber.size + 1);
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<PersonLd />
	</head>
	<body>
		<Header />

		<main>
			<!-- Title block -->
			<section class="sheet title" aria-labelledby="name">
				<div class="title-grid">
					<div class="column">
						<h1 id="name">{IDENTITY.name}</h1>
						<p class="tagline line">
							{IDENTITY.taglinePrefix}{' '}<span
								class="rotator"
								data-rotator
								data-terms={JSON.stringify(IDENTITY.rotating)}>{IDENTITY.rotating[0]}</span
							><span class="caret" aria-hidden="true"></span>
						</p>
					</div>
					<Image
						class="emblem"
						src={discipline}
						width={1102}
						sizes="(max-width: 40rem) 132px, (max-width: 68rem) 34vw, 380px"
						densities={[1, 2]}
						loading="eager"
						alt="Hand-drawn sketch of a figure turning away from a plate of food, captioned DISCIPLINE."
					/>
				</div>

				<div class="foot">
					<div class="reach">
						<ul class="contacts">
							{
								IDENTITY.links.map((link) => (
									<li>
										<a
											class={link.text ? 'as-text' : undefined}
											href={link.href}
											aria-label={link.text ? undefined : link.label}
											target={link.href.startsWith('http') ? '_blank' : undefined}
											rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
										>
											{link.text ? link.text : <Icon name={link.icon} />}
										</a>
									</li>
								))
							}
						</ul>
						<a class="resume" href={IDENTITY.resume.href}>{IDENTITY.resume.label}</a>
					</div>
					<p class="stamp">
						Rev {REVISION.rev} · {REVISION.status} ·{' '}
						<time datetime={REVISION.updated}>{REVISION.updated}</time>
					</p>
				</div>

			</section>

			<!-- Features: the credential list -->
			<section class="sheet section" aria-labelledby="features">
				<SectionHead {...section('features')} />
				<ul class="features">
					{
						CREDENTIALS.map((c) => (
							<li class:list={[{ unconfirmed: !c.confirmed }]}>
								<span class="feature-text">
									{c.href ? (
										<a href={c.href} target="_blank" rel="noopener noreferrer">
											{c.text}
										</a>
									) : (
										c.text
									)}
								</span>
								{c.sources ? (
									<details class="feature-source">
										<summary>
											<span class="feature-note">{c.note}</span>
										</summary>
										{c.sources.map((q) => (
											<blockquote>
												<p>&ldquo;{q.text}&rdquo;</p>
												<cite>
													{q.href ? (
														<a href={q.href} target="_blank" rel="noopener noreferrer">
															{q.source}
														</a>
													) : (
														q.source
													)}
												</cite>
											</blockquote>
										))}
									</details>
								) : (
									<span class="feature-note">{c.note}</span>
								)}
							</li>
						))
					}
				</ul>
			</section>

			<!-- Specifications -->
			<section class="sheet section" aria-labelledby="specs">
				<SectionHead {...section('specs')} />
				<table class="spec">
					<tbody>
						{
							SPECS.map((s) => (
								<tr>
									<th scope="row">{s.key}</th>
									<td class:list={[{ tbd: s.value === 'TBD' }]}>{s.value}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</section>

			<!-- Selected work -->
			<section class="sheet section" aria-labelledby="work">
				<SectionHead {...section('work')} />

				<ol class="projects">
					{
						PROJECTS.map((p, i) => (
							<li class="project">
								<div class="project-body">
									<span class="designator">P{i + 1}</span>
									<h3>
										{p.titleHref ? <a href={p.titleHref}>{p.title}</a> : p.title}
									</h3>

									{p.figure && <Figure figure={p.figure} n={figureNumber.get(i)!} />}

									<p class="summary">{p.summary}</p>
									<table class="spec params">
										<tbody>
											{p.params.map((param) => (
												<tr>
													<th scope="row">{param.key}</th>
													<td class:list={[{ tbd: param.value === 'TBD' }]}>{param.value}</td>
												</tr>
											))}
										</tbody>
									</table>
									<ul class="project-links">
										{p.links.map((l) => (
											<li>
												<a href={l.href}>{l.label}</a>
											</li>
										))}
									</ul>
								</div>
							</li>
						))
					}
				</ol>
			</section>

		</main>

		<Footer />

		<script>
			// Module scripts run once, but the client router swaps pages without
			// a reload, so init on every page load, and clear the pending timer
			// or two loops end up racing on the same element.
			let timer;

			const start = () => {
				const rotator = document.querySelector('[data-rotator]');
				const line = rotator && rotator.closest('.tagline');
				const still = window.matchMedia('(prefers-reduced-motion: reduce)');

				clearTimeout(timer);
				if (!rotator || !line || still.matches) return;

				const terms = JSON.parse(rotator.dataset.terms || '[]');
				if (terms.length < 2) return;

				const TYPE = 62;
				const DELETE = 34;
				const REST = 1900;
				const BEAT = 420;

				let term = 0;
				let chars = terms[0].length;
				let erasing = false;

				const wait = (ms) => new Promise((r) => (timer = setTimeout(r, ms)));

				const tick = async () => {
					if (!rotator.isConnected) return;

					if (!erasing && chars === terms[term].length) {
						// Hold with the caret blinking before erasing.
						line.classList.remove('is-typing');
						await wait(REST);
						erasing = true;
					} else if (erasing && chars === 0) {
						await wait(BEAT);
						erasing = false;
						term = (term + 1) % terms.length;
					}

					line.classList.add('is-typing');
					chars += erasing ? -1 : 1;
					rotator.textContent = terms[term].slice(0, chars);

					await wait(erasing ? DELETE : TYPE);
					tick();
				};

				tick();
			};

			document.addEventListener('astro:page-load', start);
		</script>
	</body>
</html>

<style>
	/* --- Title block --- */
	.title {
		padding-block: var(--s-7) var(--s-6);
	}

	.title-grid {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: var(--s-6);
	}

	h1 {
		font-size: var(--t-display);
		line-height: 1.02;
		letter-spacing: -0.035em;
	}

	/* The stem and the typed term share one line box, so they wrap together
	   and the block grows a line whenever a long term is typed in, moving
	   everything below it, mid-word, every couple of seconds. Reserving the
	   tallest state costs nothing, measured with Geist, every one of the
	   six terms already fills exactly three lines from 1440px to 320px;
	   only the half-typed states are shorter, and holds the page still.
	   (DESIGN.md claimed the split stem prevented this. It does not.) */
	.tagline {
		font-size: var(--t-lg);
		line-height: 1.25;
		letter-spacing: -0.02em;
		color: var(--muted);
		margin: var(--s-4) 0 0 0;
		max-width: 22ch;
		min-height: 3.75em;
	}

	/* The typed term is the tail of the sentence, so characters are only
	   ever added or removed after every other word. Nothing reflows. */
	.rotator {
		color: var(--accent);
	}

	.caret {
		display: inline-block;
		width: 2px;
		height: 0.78em;
		background: var(--accent);
		/* Bottom of the bar rests on the baseline, like a real text caret;
		   text-bottom dropped it onto the descender line. */
		vertical-align: baseline;
		margin-left: 3px;
		animation: blink 1.06s step-end infinite;
	}

	/* Solid while characters are moving; it only blinks while resting. */
	.tagline.is-typing .caret {
		animation: none;
		opacity: 1;
	}

	@keyframes blink {
		0%,
		49% {
			opacity: 1;
		}
		50%,
		100% {
			opacity: 0;
		}
	}

	.emblem {
		width: clamp(200px, 34vw, 380px);
		height: auto;
		flex: none;
		align-self: flex-start;
		/* The sketch is drawn on white, so it sits on the paper without a frame. */
		mix-blend-mode: multiply;
	}

	.foot {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--s-4);
		flex-wrap: wrap;
		margin-top: var(--s-6);
	}

	.reach {
		display: flex;
		align-items: center;
		gap: var(--s-4);
		flex-wrap: wrap;
	}

	.resume {
		font-family: var(--font-geist-mono);
		font-size: var(--t-xs);
		letter-spacing: 0.02em;
		text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
	}

	@media (hover: hover) {
		.resume:hover {
			text-decoration-color: var(--accent);
	
		}
	}

	.contacts {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--s-2) var(--s-6);
	}

	.contacts {
		gap: var(--s-4);
	}

	.contacts a {
		display: block;
		color: var(--accent);
		line-height: 0;
		padding: var(--s-1);
		margin: calc(-1 * var(--s-1));
		transition: color 120ms ease-out;
	}

	@media (hover: hover) {
		.contacts a:hover {
			color: color-mix(in srgb, var(--accent) 72%, #000);
	
		}
	}

	/* The address is set, not drawn, so it needs the line-height the glyphs
	   gave up, and the mono of every other literal value on the sheet. */
	.contacts a.as-text {
		font-family: var(--font-geist-mono);
		font-size: var(--t-xs);
		letter-spacing: 0.02em;
		line-height: 1;
		text-decoration: underline;
		text-underline-offset: 0.25em;
		text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
	}

	@media (hover: hover) {
		.contacts a.as-text:hover {
			text-decoration-color: var(--accent);
	
		}
	}

	.stamp {
		margin: 0;
		font-family: var(--font-geist-mono);
		font-size: var(--t-xs);
		font-variant-numeric: tabular-nums;
		color: var(--accent);
		white-space: nowrap;
	}


	@media (prefers-reduced-motion: reduce) {
		.caret {
			animation: none;
		}
	}

	/* --- Features --- */
	.features {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.features li {
		display: flex;
		flex-direction: column;
		gap: var(--s-1);
		padding: var(--s-3) var(--s-2);
		margin-inline: calc(-1 * var(--s-2));
		border-radius: 2px;
		transition: background-color 120ms ease-out;
	}

	@media (hover: hover) {
		.features li:hover {
			background: var(--wash);
		}
	}

	.feature-text {
		font-size: var(--t-md);
		line-height: 1.35;
		letter-spacing: -0.01em;
	}

	/* The list is ordered most-impressive-first, so the lead entry is the
	   hook PRODUCT.md names. It was set identically to the last credential;
	   the project list has carried graded legibility all along and this one
	   never got it. */
	.features li:first-child .feature-text {
		font-size: var(--t-lg);
		line-height: 1.2;
		letter-spacing: -0.02em;
	}

	.feature-text a {
		color: var(--ink);
		text-decoration: none;
		background-image: linear-gradient(var(--accent), var(--accent));
		background-repeat: no-repeat;
		background-position: 0 100%;
		background-size: 0% var(--hairline);
		transition:
			background-size 260ms cubic-bezier(0.2, 0.8, 0.2, 1),
			color 160ms ease-out;
	}

	@media (hover: hover) {
		.feature-text a:hover,
		.feature-text a:focus-visible {
			color: var(--accent);
			background-size: 100% var(--hairline);
		}
	}

	/* No hover means no way to discover these are links. Two credentials
	   carry the externally verifiable sources, so on touch the underline
	   is simply always drawn. */
	@media (hover: none) {
		.feature-text a {
			background-size: 100% var(--hairline);
		}
	}

	.features li.unconfirmed .feature-text {
		font-size: var(--t-base);
		color: var(--muted);
	}

	.feature-note {
		font-size: var(--t-xs);
		color: var(--muted);
	}

	/* Somebody else's words under a credential, folded away until asked for.
	   Several lines of quotation outweigh the credential they support, so
	   the evidence is available rather than spent: the reader sees an arrow
	   and opens it only if the claim needs settling.

	   The note itself is the control, with the arrow after it, so the
	   disclosure costs no extra line and the target is a whole line of text
	   rather than a glyph.

	   `<details>` is the entire mechanism. No script, so it works with
	   scripts blocked, and because it opens only on user input it sits
	   inside the "nothing moves without user input" rule rather than beside
	   it as another exception. */
	.feature-source summary {
		display: block;
		width: fit-content;
		cursor: pointer;
		/* Padding for the touch target, negative margin to give back the
		   space, so the note sits exactly where it does without a
		   disclosure and the two kinds of credential still line up. */
		padding-block: var(--s-2);
		margin-block: calc(-1 * var(--s-2));
		/* Firefox, and modern Chrome. */
		list-style: none;
	}

	/* Safari, and Chrome before it honoured `list-style` here. */
	.feature-source summary::-webkit-details-marker {
		display: none;
	}

	/* Drawn rather than the platform triangle, and swapped rather than
	   rotated: a glyph change needs no motion to read as a state change. */
	.feature-source summary::after {
		content: '\25B8';
		margin-left: 0.45em;
		color: var(--accent);
	}

	.feature-source[open] summary::after {
		content: '\25BE';
	}

	@media (hover: hover) {
		.feature-source summary:hover .feature-note {
			color: var(--ink);
		}
	}

	/* The rule down the left is what marks the block as quoted rather than
	   as a second note; it and the note both sit at 14px in the muted
	   colour, so without it they would read as one run-on line. */
	.feature-source blockquote {
		margin: var(--s-3) 0 0 0;
		padding-left: var(--s-3);
		border-left: var(--hairline) solid var(--rule);
		max-width: 62ch;
	}

	.feature-source blockquote p {
		margin: 0;
		font-size: var(--t-xs);
		line-height: 1.5;
		color: var(--muted);
		text-wrap: pretty;
	}

	.feature-source cite {
		display: block;
		margin-top: var(--s-1);
		font-size: var(--t-xs);
		font-style: normal;
	}

	/* --- Projects. Graded legibility: the list compresses downward. --- */
	.projects {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	/* One column at every width. The figure used to be a second column
	   floated beside the text, which put it *after* the summary, parameters
	   and links in source order, so on a phone, where the row collapses to
	   one column, the picture landed at the bottom of the block it was there
	   to introduce. It now follows the title directly: name, artifact,
	   details. That is also the order a screen reader announces. */
	.project {
		padding: var(--s-6) var(--s-2);
		margin-inline: calc(-1 * var(--s-2));
		border-radius: 2px;
		transition: background-color 120ms ease-out;
	}

	@media (hover: hover) {
		.project:hover {
			background: var(--wash);
	
		}
	}

	.project:first-child {
		padding-top: var(--s-4);
	}

	/* A hanging indent: the designator sits in its own gutter and the title,
	   summary, parameters and links all share one left edge. Previously the
	   title was a flex sibling of the designator, so it started ~50px in
	   while everything below it was flush left, invisible on desktop where
	   the title fits one line, glaring on a phone where it wraps to three. */
	.project-body {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		column-gap: var(--s-3);
	}

	.project-body > .designator {
		grid-column: 1;
		grid-row: 1;
	}

	.project-body > :not(.designator) {
		grid-column: 2;
	}

	.project-body > h3 {
		grid-row: 1;
	}

	/* The figure is rendered by `Figure.astro`, so it carries that
	   component's scope id and not this page's. The scoped
	   `> :not(.designator)` above cannot see across that boundary, and
	   without this the figure falls into the designator's gutter column
	   and squeezes the whole row to a sliver. It looks like a grid bug and
	   is a scoping one. */
	.project-body > :global(figure) {
		grid-column: 2;
	}

	/* The params table is inset 8px by the shared .spec rule, which would
	   put it one step off the summary above it. */
	.params th:first-child {
		padding-left: 0;
	}

	.project h3 {
		font-size: var(--t-md);
		font-family: var(--font-geist-mono);
		font-weight: 500;
	}

	.project h3 a {
		color: var(--ink);
		text-decoration: none;
		background-image: linear-gradient(var(--accent), var(--accent));
		background-repeat: no-repeat;
		background-position: 0 100%;
		background-size: 0% var(--hairline);
		transition:
			background-size 260ms cubic-bezier(0.2, 0.8, 0.2, 1),
			color 160ms ease-out;
	}

	@media (hover: hover) {
		.project h3 a:hover,
		.project h3 a:focus-visible {
			color: var(--accent);
			background-size: 100% var(--hairline);
		}
	}

	/* A project title is a link only when it has a `titleHref`, so some are and
	   some are not. Without hover a phone reader cannot tell which, so the
	   underline is always drawn. (Naming the specific rows here went stale the
	   first time the list was reordered.) */
	@media (hover: none) {
		.project h3 a {
			background-size: 100% var(--hairline);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.project h3 a {
			transition: none;
		}
	}


	/* Graded legibility, carried to eight rows. Written in :nth-child so the
	   curve tracks the list's length rather than a rank number someone has to
	   remember to move. It was `.rank-4`, hardcoded as "the last one", so at
	   eight entries row 4 shrank while rows 5-8 below it stayed full size,
	   the curve inverted exactly where it was supposed to keep descending. */
	.project:first-child h3 {
		font-size: var(--t-lg);
		letter-spacing: -0.025em;
	}

	.summary {
		margin: var(--s-2) 0 var(--s-4) 0;
		color: var(--muted);
		max-width: 60ch;
	}

	.project:first-child .summary {
		color: var(--ink);
		font-size: var(--t-md);
		line-height: 1.5;
	}

	/* Row five is where the list stops arguing and starts listing. */
	.project:nth-child(n + 5) h3,
	.project:nth-child(n + 5) .summary {
		font-size: var(--t-base);
	}

	/* Seven and beyond close up: the summary's bottom margin is the largest
	   single contributor to a row's height once the type has stopped
	   shrinking. §3 is already 64% of the document at 390px, so the tail has
	   to cost less per row than the head does. */
	.project:nth-child(n + 7) {
		padding-block: var(--s-4);
	}

	.project:nth-child(n + 7) .summary {
		margin-bottom: var(--s-2);
	}

	.params {
		max-width: 24rem;
		margin-bottom: var(--s-3);
	}

	.project-links {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-4);
		margin: 0;
		padding: 0;
		font-size: var(--t-xs);
	}

	/* --- Figures. The photo slot states the shot it needs. --- */
	/* --- Adaptation. Mobile is the default case. --- */
	@media (max-width: 52rem) {
		/* Full width matters more than the gutter at this size: the
		   designator takes its own line and everything stays flush left. */
		.project-body {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--s-2);
		}

		.project-body > .designator,
		.project-body > h3,
		.project-body > :global(figure),
		.project-body > :not(.designator) {
			grid-column: 1;
