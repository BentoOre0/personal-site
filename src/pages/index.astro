---
import { Image } from 'astro:assets';
import discipline from '../assets/discipline-crop2.png';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { CREDENTIALS, IDENTITY, PROJECTS, REVISION, SPECS } from '../data/profile';

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<main>
			<!-- Title block -->
			<section class="sheet title" aria-labelledby="name">
				<div class="title-grid">
					<div class="column">
						<h1 id="name">{IDENTITY.name}</h1>
						<p class="tagline line">
							{IDENTITY.taglinePrefix}{' '}<span
								class="rotator"
								data-rotator
								data-terms={JSON.stringify(IDENTITY.rotating)}>{IDENTITY.rotating[0]}</span
							><span class="caret" aria-hidden="true"></span>
						</p>
					</div>
					<Image
						class="emblem"
						src={discipline}
						width={1102}
						sizes="(max-width: 40rem) 132px, (max-width: 68rem) 34vw, 380px"
						densities={[1, 2]}
						loading="eager"
						alt="Hand-drawn sketch of a figure turning away from a plate of food, captioned DISCIPLINE."
					/>
				</div>

				<div class="foot">
					<div class="reach">
						<ul class="contacts">
							{
								IDENTITY.links.map((link) => (
									<li>
										<a
											class={link.text ? 'as-text' : undefined}
											href={link.href}
											aria-label={link.text ? undefined : link.label}
											target={link.href.startsWith('http') ? '_blank' : undefined}
											rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
										>
											{link.text ? link.text : <Icon name={link.icon} />}
										</a>
									</li>
								))
							}
						</ul>
						<a class="resume" href={IDENTITY.resume.href}>{IDENTITY.resume.label}</a>
					</div>
					<p class="stamp">
						Rev {REVISION.rev} · {REVISION.status} ·{' '}
						<time datetime={REVISION.updated}>{REVISION.updated}</time>
					</p>
				</div>

			</section>

			<!-- Features: the credential list -->
			<section class="sheet section" aria-labelledby="features">
				<div class="section-head">
					<a class="designator anchor" href="#features">§1</a>
					<h2 id="features">Credentials</h2>
				</div>
				<ul class="features">
					{
						CREDENTIALS.map((c) => (
							<li class:list={[{ unconfirmed: !c.confirmed }]}>
								<span class="feature-text">
									{c.href ? (
										<a href={c.href} target="_blank" rel="noopener noreferrer">
											{c.text}
										</a>
									) : (
										c.text
									)}
								</span>
								<span class="feature-note">{c.note}</span>
							</li>
						))
					}
				</ul>
			</section>

			<!-- Specifications -->
			<section class="sheet section" aria-labelledby="specs">
				<div class="section-head">
					<a class="designator anchor" href="#specs">§2</a>
					<h2 id="specs">Details</h2>
				</div>
				<table class="spec">
					<tbody>
						{
							SPECS.map((s) => (
								<tr>
									<th scope="row">{s.key}</th>
									<td class:list={[{ tbd: s.value === 'TBD' }]}>{s.value}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</section>

			<!-- Selected work -->
			<section class="sheet section" aria-labelledby="work">
				<div class="section-head">
					<a class="designator anchor" href="#work">§3</a>
					<h2 id="work">Projects</h2>
				</div>

				<ol class="projects">
					{
						PROJECTS.map((p, i) => (
							<li class="project" class:list={[`rank-${i + 1}`]}>
								<div class="project-body">
									<span class="designator">{p.id}</span>
									<h3>
										{p.links[0] ? (
											<a href={p.links[0].href}>{p.title}</a>
										) : (
											p.title
										)}
									</h3>
									<p class="summary">{p.summary}</p>
									<table class="spec params">
										<tbody>
											{p.params.map((param) => (
												<tr>
													<th scope="row">{param.key}</th>
													<td class:list={[{ tbd: param.value === 'TBD' }]}>{param.value}</td>
												</tr>
											))}
										</tbody>
									</table>
									<ul class="project-links">
										{p.links.map((l) => (
											<li>
												<a href={l.href}>{l.label}</a>
											</li>
										))}
									</ul>
								</div>

								{p.figure && (
									<figure class="figure">
										<div
											class="plate"
											role="img"
											aria-label={`Figure ${i + 1} placeholder`}
											style={`aspect-ratio: ${p.figure.ratio};`}
										>
											<span class="legend">Fig. {i + 1}</span>
											<span class="plate-spec">{p.figure.spec}</span>
										</div>
										<figcaption>
											<span class="designator">Fig. {i + 1}</span>
											{' '}{p.figure.caption}
										</figcaption>
									</figure>
								)}
							</li>
						))
					}
				</ol>
			</section>

		</main>

		<Footer />

		<script>
			// Module scripts run once, but the client router swaps pages without
			// a reload — so init on every page load, and clear the pending timer
			// or two loops end up racing on the same element.
			let timer;

			const start = () => {
				const rotator = document.querySelector('[data-rotator]');
				const line = rotator && rotator.closest('.tagline');
				const still = window.matchMedia('(prefers-reduced-motion: reduce)');

				clearTimeout(timer);
				if (!rotator || !line || still.matches) return;

				const terms = JSON.parse(rotator.dataset.terms || '[]');
				if (terms.length < 2) return;

				const TYPE = 62;
				const DELETE = 34;
				const REST = 1900;
				const BEAT = 420;

				let term = 0;
				let chars = terms[0].length;
				let erasing = false;

				const wait = (ms) => new Promise((r) => (timer = setTimeout(r, ms)));

				const tick = async () => {
					if (!rotator.isConnected) return;

					if (!erasing && chars === terms[term].length) {
						// Hold with the caret blinking before erasing.
						line.classList.remove('is-typing');
						await wait(REST);
						erasing = true;
					} else if (erasing && chars === 0) {
						await wait(BEAT);
						erasing = false;
						term = (term + 1) % terms.length;
					}

					line.classList.add('is-typing');
					chars += erasing ? -1 : 1;
					rotator.textContent = terms[term].slice(0, chars);

					await wait(erasing ? DELETE : TYPE);
					tick();
				};

				tick();
			};

			document.addEventListener('astro:page-load', start);
		</script>
	</body>
</html>

<style>
	/* --- Title block --- */
	.title {
		padding-block: var(--s-7) var(--s-6);
	}

	.title-grid {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: var(--s-6);
	}

	h1 {
		font-size: var(--t-display);
		line-height: 1.02;
		letter-spacing: -0.035em;
	}

	/* The stem and the typed term share one line box, so they wrap together
	   and the block grows a line whenever a long term is typed in — moving
	   everything below it, mid-word, every couple of seconds. Reserving the
	   tallest state costs nothing — measured with Geist, every one of the
	   six terms already fills exactly three lines from 1440px to 320px;
	   only the half-typed states are shorter — and holds the page still.
	   (DESIGN.md claimed the split stem prevented this. It does not.) */
	.tagline {
		font-size: var(--t-lg);
		line-height: 1.25;
		letter-spacing: -0.02em;
		color: var(--muted);
		margin: var(--s-4) 0 0 0;
		max-width: 22ch;
		min-height: 3.75em;
	}

	/* The typed term is the tail of the sentence, so characters are only
	   ever added or removed after every other word. Nothing reflows. */
	.rotator {
		color: var(--accent);
	}

	.caret {
		display: inline-block;
		width: 2px;
		height: 0.78em;
		background: var(--accent);
		/* Bottom of the bar rests on the baseline, like a real text caret;
		   text-bottom dropped it onto the descender line. */
		vertical-align: baseline;
		margin-left: 3px;
		animation: blink 1.06s step-end infinite;
	}

	/* Solid while characters are moving; it only blinks while resting. */
	.tagline.is-typing .caret {
		animation: none;
		opacity: 1;
	}

	@keyframes blink {
		0%,
		49% {
			opacity: 1;
		}
		50%,
		100% {
			opacity: 0;
		}
	}

	.emblem {
		width: clamp(200px, 34vw, 380px);
		height: auto;
		flex: none;
		align-self: flex-start;
		/* The sketch is drawn on white, so it sits on the paper without a frame. */
		mix-blend-mode: multiply;
	}

	.foot {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--s-4);
		flex-wrap: wrap;
		margin-top: var(--s-6);
	}

	.reach {
		display: flex;
		align-items: center;
		gap: var(--s-4);
		flex-wrap: wrap;
	}

	.resume {
		font-family: var(--font-geist-mono);
		font-size: var(--t-xs);
		letter-spacing: 0.02em;
		text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
	}

	@media (hover: hover) {
		.resume:hover {
			text-decoration-color: var(--accent);
	
		}
	}

	.contacts {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--s-2) var(--s-6);
	}

	.contacts {
		gap: var(--s-4);
	}

	.contacts a {
		display: block;
		color: var(--accent);
		line-height: 0;
		padding: var(--s-1);
		margin: calc(-1 * var(--s-1));
		transition: color 120ms ease-out;
	}

	@media (hover: hover) {
		.contacts a:hover {
			color: color-mix(in srgb, var(--accent) 72%, #000);
	
		}
	}

	/* The address is set, not drawn, so it needs the line-height the glyphs
	   gave up — and the mono of every other literal value on the sheet. */
	.contacts a.as-text {
		font-family: var(--font-geist-mono);
		font-size: var(--t-xs);
		letter-spacing: 0.02em;
		line-height: 1;
		text-decoration: underline;
		text-underline-offset: 0.25em;
		text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
	}

	@media (hover: hover) {
		.contacts a.as-text:hover {
			text-decoration-color: var(--accent);
	
		}
	}

	.stamp {
		margin: 0;
		font-family: var(--font-geist-mono);
		font-size: var(--t-xs);
		font-variant-numeric: tabular-nums;
		color: var(--accent);
		white-space: nowrap;
	}


	@media (prefers-reduced-motion: reduce) {
		.caret {
			animation: none;
		}
	}

	/* --- Features --- */
	.features {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.features li {
		display: flex;
		flex-direction: column;
		gap: var(--s-1);
		padding: var(--s-3) var(--s-2);
		margin-inline: calc(-1 * var(--s-2));
		border-radius: 2px;
		transition: background-color 120ms ease-out;
	}

	@media (hover: hover) {
		.features li:hover {
			background: var(--wash);
		}
	}

	.feature-text {
		font-size: var(--t-md);
		line-height: 1.35;
		letter-spacing: -0.01em;
	}

	/* The list is ordered most-impressive-first, so the lead entry is the
	   hook PRODUCT.md names. It was set identically to the last credential;
	   the project list has carried graded legibility all along and this one
	   never got it. */
	.features li:first-child .feature-text {
		font-size: var(--t-lg);
		line-height: 1.2;
		letter-spacing: -0.02em;
	}

	.feature-text a {
		color: var(--ink);
		text-decoration: none;
		background-image: linear-gradient(var(--accent), var(--accent));
		background-repeat: no-repeat;
		background-position: 0 100%;
		background-size: 0% var(--hairline);
		transition:
			background-size 260ms cubic-bezier(0.2, 0.8, 0.2, 1),
			color 160ms ease-out;
	}

	@media (hover: hover) {
		.feature-text a:hover,
		.feature-text a:focus-visible {
			color: var(--accent);
			background-size: 100% var(--hairline);
		}
	}

	/* No hover means no way to discover these are links. Two credentials
	   carry the externally verifiable sources, so on touch the underline
	   is simply always drawn. */
	@media (hover: none) {
		.feature-text a {
			background-size: 100% var(--hairline);
		}
	}

	.features li.unconfirmed .feature-text {
		font-size: var(--t-base);
		color: var(--muted);
	}

	.feature-note {
		font-size: var(--t-xs);
		color: var(--muted);
	}

	/* --- Projects. Graded legibility: the list compresses downward. --- */
	.projects {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.project {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
		gap: var(--s-6);
		align-items: start;
		padding: var(--s-6) var(--s-2);
		margin-inline: calc(-1 * var(--s-2));
		border-radius: 2px;
		transition: background-color 120ms ease-out;
	}

	@media (hover: hover) {
		.project:hover {
			background: var(--wash);
	
		}
	}

	.project:first-child {
		padding-top: var(--s-4);
	}

	/* A hanging indent: the designator sits in its own gutter and the title,
	   summary, parameters and links all share one left edge. Previously the
	   title was a flex sibling of the designator, so it started ~50px in
	   while everything below it was flush left — invisible on desktop where
	   the title fits one line, glaring on a phone where it wraps to three. */
	.project-body {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		column-gap: var(--s-3);
	}

	.project-body > .designator {
		grid-column: 1;
		grid-row: 1;
	}

	.project-body > :not(.designator) {
		grid-column: 2;
	}

	.project-body > h3 {
		grid-row: 1;
	}

	/* The params table is inset 8px by the shared .spec rule, which would
	   put it one step off the summary above it. */
	.params th:first-child {
		padding-left: 0;
	}

	.project h3 {
		font-size: var(--t-md);
		font-family: var(--font-geist-mono);
		font-weight: 500;
	}

	.project h3 a {
		color: var(--ink);
		text-decoration: none;
		background-image: linear-gradient(var(--accent), var(--accent));
		background-repeat: no-repeat;
		background-position: 0 100%;
		background-size: 0% var(--hairline);
		transition:
			background-size 260ms cubic-bezier(0.2, 0.8, 0.2, 1),
			color 160ms ease-out;
	}

	@media (hover: hover) {
		.project h3 a:hover,
		.project h3 a:focus-visible {
			color: var(--accent);
			background-size: 100% var(--hairline);
		}
	}

	/* P2, P3 and P4 titles are links and P1/P5 are not. Without hover a
	   phone reader cannot tell which, so the underline is always drawn. */
	@media (hover: none) {
		.project h3 a {
			background-size: 100% var(--hairline);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.project h3 a {
			transition: none;
		}
	}


	.rank-1 h3 {
		font-size: var(--t-lg);
		letter-spacing: -0.025em;
	}

	.summary {
		margin: var(--s-2) 0 var(--s-4) 0;
		color: var(--muted);
		max-width: 60ch;
	}

	.rank-1 .summary {
		color: var(--ink);
		font-size: var(--t-md);
		line-height: 1.5;
	}

	.rank-4 .summary,
	.rank-4 h3 {
		font-size: var(--t-base);
	}

	.params {
		max-width: 24rem;
		margin-bottom: var(--s-3);
	}

	.project-links {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-4);
		margin: 0;
		padding: 0;
		font-size: var(--t-xs);
	}

	/* --- Figures. The photo slot states the shot it needs. --- */
	.figure {
		margin: 0;
	}

	figcaption {
		margin-top: var(--s-2);
		font-size: var(--t-xs);
		color: var(--muted);
	}


	/* --- Adaptation. Mobile is the default case. --- */
	@media (max-width: 52rem) {
		/* Full width matters more than the gutter at this size: the
		   designator takes its own line and everything stays flush left. */
		.project-body {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--s-2);
		}

		.project-body > .designator,
		.project-body > h3,
		.project-body > :not(.designator) {
			grid-column: 1;
		}

		.project-body > .designator,
		.project-body > h3 {
			grid-row: auto;
		}

		.project {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--s-4);
		}

		.figure {
			max-width: 20rem;
		}
	}

	@media (max-width: 40rem) {
		.title {
			padding-block: var(--s-6) var(--s-5);
		}

		.title-grid {
			flex-direction: column-reverse;
			align-items: flex-start;
			gap: var(--s-4);
		}


		.emblem {
			width: 132px;
		}


		.foot {
			align-items: flex-start;
			gap: var(--s-3);
		}

		/* Tightened so contacts and the résumé link share one row: at the
		   wider gaps the row measured 370px against a 342px column and the
		   highest-intent link on the page was orphaned onto its own line. */
		.reach {
			gap: var(--s-3);
		}

		.contacts {
			gap: var(--s-3);
		}

		/* Reference metadata, and the footer already prints it in full. On a
		   phone this row was pushing the lead credential past the fold. */
		.stamp {
			display: none;
		}

	}

	@media (max-width: 30rem) {
		/* 34 mono characters is wider than a 320px viewport's content box,
		   and nowrap would push the page sideways. */
		.stamp {
			white-space: normal;
		}
	}
</style>
