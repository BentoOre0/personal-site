---
import { Image } from 'astro:assets';
import discipline from '../assets/discipline-crop2.png';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Figure from '../components/Figure.astro';
import Icon from '../components/Icon.astro';
import PersonLd from '../components/PersonLd.astro';
import SectionHead from '../components/SectionHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { CREDENTIALS, IDENTITY, PROJECTS, REVISION, SPECS } from '../data/profile';

/* The homepage's sections, in the order they appear. §N is derived from this
   list, so inserting a section renumbers everything after it automatically.
   The numbers used to be literal text in three places; a missed renumber gave
   the page two §3s with a green build and no warning.

   `id`s are permalink targets and are historical, `features` renders as
   "Credentials", `specs` as "Details", `work` as "Projects". Do not rename
   them; someone may have saved a link. */
const SECTIONS = [
	{ id: 'features', title: 'Credentials' },
	{ id: 'specs', title: 'Details' },
	{ id: 'work', title: 'Projects' },
] as const;

const section = (id: (typeof SECTIONS)[number]['id']) => {
	const i = SECTIONS.findIndex((s) => s.id === id);
	return { ...SECTIONS[i], n: i + 1 };
};

/* A figure carries the number of the row it documents. Fig. 4 sits in P4.

   This used to be its own sequential counter, incremented only on rows that
   actually had a figure, so that the printed numbers ran 1, 2, 3 with no
   gaps. That bought contiguity and paid for it in desynchronisation: P3 has
   no figure, so P4 carried "Fig. 3", P5 carried "Fig. 4", and by P7 the two
   handles were two apart. The reader has no way to see why, and the drift
   grows with every figure-less row added above.

   A gap explains itself, a desync does not. Missing a Fig. 3 says "P3 has no
   picture", which is true and visible one row up. So the two numbering
   systems are now one: every figure number equals its project number, and
   panels letter off it, Fig. 4(a), Fig. 4(b). */
const figureNumber = new Map<number, number>();
PROJECTS.forEach((p, i) => {
	if (p.figure) figureNumber.set(i, i + 1);
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<PersonLd />
	</head>
	<body>
		<Header />

		<main>
			<!-- Title block -->
			<section class="sheet title" aria-labelledby="name">
				<div class="title-grid">
					<div class="column">
						<h1 id="name">{IDENTITY.name}</h1>
						<p class="tagline line">
							{IDENTITY.taglinePrefix}{' '}<span
								class="rotator"
								data-rotator
								data-terms={JSON.stringify(IDENTITY.rotating)}>{IDENTITY.rotating[0]}</span
							><span class="caret" aria-hidden="true"></span>
						</p>
					</div>
					<Image
						class="emblem"
						src={discipline}
						width={1102}
						sizes="(max-width: 40rem) 132px, (max-width: 68rem) 34vw, 380px"
						densities={[1, 2]}
						loading="eager"
						alt="Hand-drawn sketch of a figure turning away from a plate of food, captioned DISCIPLINE."
					/>
				</div>

				<div class="foot">
					<div class="reach">
						<ul class="contacts">
							{
								IDENTITY.links.map((link) => (
									<li>
										<a
											class={link.text ? 'as-text' : undefined}
											href={link.href}
											aria-label={link.text ? undefined : link.label}
											target={link.href.startsWith('http') ? '_blank' : undefined}
											rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
										>
											{link.text ? link.text : <Icon name={link.icon} />}
										</a>
									</li>
								))
							}
						</ul>
						<a class="resume" href={IDENTITY.resume.href}>{IDENTITY.resume.label}</a>
					</div>
					<p class="stamp">
						Rev {REVISION.rev} · {REVISION.status} ·{' '}
						<time datetime={REVISION.updated}>{REVISION.updated}</time>
					</p>
				</div>

			</section>

			<!-- Features: the credential list -->
			<section class="sheet section" aria-labelledby="features">
				<SectionHead {...section('features')} />
				<ul class="features">
					{
						CREDENTIALS.map((c) => (
							<li class:list={[{ unconfirmed: !c.confirmed }]}>
								<span class="feature-text">
									{c.href ? (
										<a href={c.href} target="_blank" rel="noopener noreferrer">
											{c.text}
										</a>
									) : (
										c.text
									)}
								</span>
								{c.sources ? (
									<details class="feature-source">
										<summary>
											<span class="feature-note">{c.note}</span>
										</summary>
										{c.sources.map((q) => (
											<blockquote>
												<p>&ldquo;{q.text}&rdquo;</p>
												<cite>
													{q.href ? (
														<a href={q.href} target="_blank" rel="noopener noreferrer">
															{q.source}
														</a>
													) : (
														q.source
													)}
												</cite>
											</blockquote>
										))}
									</details>
								) : (
									<span class="feature-note">{c.note}</span>
								)}
							</li>
						))
					}
				</ul>
			</section>

			<!-- Specifications -->
			<section class="sheet section" aria-labelledby="specs">
				<SectionHead {...section('specs')} />
				<table class="spec">
					<tbody>
						{
							SPECS.map((s) => (
								<tr>
									<th scope="row">{s.key}</th>
									<td class:list={[{ tbd: s.value === 'TBD' }]}>{s.value}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</section>

			<!-- Selected work -->
			<section class="sheet section" aria-labelledby="work">
				<SectionHead {...section('work')} />

				<ol class="projects">
					{
						PROJECTS.map((p, i) => (
							<li class="project">
								<div class:list={['project-body', { 'has-figure': !!p.figure }]}>
									<span class="designator">P{i + 1}</span>
									<h3>
										{p.titleHref ? <a href={p.titleHref}>{p.title}</a> : p.title}
									</h3>

									{p.figure && <Figure figure={p.figure} n={figureNumber.get(i)!} />}

									<p class="summary">{p.summary}</p>
									<table class="spec params">
										<tbody>
											{p.params.map((param) => (
												<tr>
													<th scope="row">{param.key}</th>
													<td class:list={[{ tbd: param.value === 'TBD', strong: param.strong }]}>
														{param.value}
													</td>
												</tr>
											))}
										</tbody>
									</table>
									<ul class="project-links">
										{p.links.map((l) => (
											<li>
												<a href={l.href}>{l.label}</a>
											</li>
										))}
									</ul>
								</div>
							</li>
						))
					}
				</ol>
			</section>

		</main>

		<Footer />

		<script>
			// Module scripts run once, but the client router swaps pages without
			// a reload, so init on every page load, and clear the pending timer
			// or two loops end up racing on the same element.
			let timer;

			const start = () => {
				const rotator = document.querySelector('[data-rotator]');
				const line = rotator && rotator.closest('.tagline');
				const still = window.matchMedia('(prefers-reduced-motion: reduce)');

				clearTimeout(timer);
				if (!rotator || !line || still.matches) return;

				const terms = JSON.parse(rotator.dataset.terms || '[]');
				if (terms.length < 2) return;

				/* Milliseconds per character. Typing and erasing were 62 and 34
				   and both were asked to be quicker; the two pauses are
				   deliberately unchanged, so the term still holds long enough
				   to be read and the gap between terms still lands. Only the
				   travel between those two states got shorter. */
				const TYPE = 44;
				const DELETE = 24;
				const REST = 1900;
				const BEAT = 420;

				let term = 0;
				let chars = terms[0].length;
				let erasing = false;

				const wait = (ms) => new Promise((r) => (timer = setTimeout(r, ms)));

				const tick = async () => {
					if (!rotator.isConnected) return;

					if (!erasing && chars === terms[term].length) {
						// Hold with the caret blinking before erasing.
						line.classList.remove('is-typing');
						await wait(REST);
						erasing = true;
					} else if (erasing && chars === 0) {
						await wait(BEAT);
						erasing = false;
						term = (term + 1) % terms.length;
					}

					line.classList.add('is-typing');
					chars += erasing ? -1 : 1;
					rotator.textContent = terms[term].slice(0, chars);

					await wait(erasing ? DELETE : TYPE);
					tick();
				};

				tick();
			};

			/* Wait for the loading screen to leave before typing.

			   The rotator wrote a character every 62ms from `astro:page-load`,
			   which is the same instant the loader begins its 1400ms hold. So
			   for the whole time the overlay is up, this was doing layout on
			   the main thread behind an opaque sheet where nobody could see
			   it, competing with the one animation that is on screen. That is
			   the choppiness, and the fix costs nothing: the typing was
			   invisible anyway.

			   It also reads better. The reader now sees the term typed from
			   its first character instead of arriving part-way through.

			   The failsafe matters. If Loader.astro never runs, the event
			   never fires, so a timer starts the rotator regardless. The
			   tagline animating late is a small fault; a tagline stuck on one
			   term forever is a visible one. */
			const startOnce = (() => {
				let started = false;
				return () => {
					if (started) return;
					started = true;
					start();
				};
			})();

			document.addEventListener('astro:page-load', () => {
				const loader = document.getElementById('loader');
				if (!loader || loader.classList.contains('is-done')) {
					start();
					return;
				}
				document.addEventListener('loader:done', startOnce, { once: true });
				setTimeout(startOnce, 3000);
			});
		</script>
	</body>
</html>

<style>
	/* --- Title block --- */
	.title {
		padding-block: var(--s-7) var(--s-6);
	}

	.title-grid {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: var(--s-6);
	}

	h1 {
		font-size: var(--t-display);
		line-height: 1.02;
		letter-spacing: -0.035em;
	}

	/* The stem and the typed term share one line box, so they wrap together
	   and the block grows a line whenever a long term is typed in, moving
	   everything below it, mid-word, every couple of seconds. Reserving the
	   tallest state costs nothing, measured with Geist, every one of the
	   six terms already fills exactly three lines from 1440px to 320px;
	   only the half-typed states are shorter, and holds the page still.
	   (DESIGN.md claimed the split stem prevented this. It does not.) */
	.tagline {
		font-size: var(--t-lg);
		line-height: 1.25;
		letter-spacing: -0.02em;
		color: var(--muted);
		margin: var(--s-4) 0 0 0;
		max-width: 22ch;
		min-height: 3.75em;
	}

	/* The reserve above is three lines, which is what every term needs while
	   `max-width: 22ch` is the thing deciding the wrap. Below about 358px the
	   viewport binds first, the measure narrows, and the longest term,
	   "physical & digital systems.", takes a fourth line where the other six
	   still take three. That is the height change the reserve exists to
	   prevent, so the reserve grows to four lines exactly where it has to.

	   Measured on the real page, not computed: 320 and 340 wrap to four
	   lines, 360, 375 and 384 wrap identically to each other and to 390,
	   which is 22ch binding rather than the viewport. Add a longer term and
	   this has to be measured again; the way to do it is to set `rotating`
	   to that one term, since the script leaves the text static below two
	   terms and a screenshot can then show it. */
	@media (max-width: 22.4rem) {
		.tagline {
			min-height: 5em;
		}
	}

	/* The typed term is the tail of the sentence, so characters are only
	   ever added or removed after every other word. Nothing reflows. */
	.rotator {
		color: var(--accent);
	}

	.caret {
		display: inline-block;
		width: 2px;
		height: 0.78em;
		background: var(--accent);
		/* Bottom of the bar rests on the baseline, like a real text caret;
		   text-bottom dropped it onto the descender line. */
		vertical-align: baseline;
		margin-left: 3px;
		animation: blink 1.06s step-end infinite;
	}

	/* Solid while characters are moving; it only blinks while resting. */
	.tagline.is-typing .caret {
		animation: none;
		opacity: 1;
	}

	@keyframes blink {
		0%,
		49% {
			opacity: 1;
		}
		50%,
		100% {
			opacity: 0;
		}
	}

	.emblem {
		width: clamp(200px, 34vw, 380px);
		height: auto;
		flex: none;
		align-self: flex-start;
		/* The sketch is drawn on white, so it sits on the paper without a frame. */
		mix-blend-mode: multiply;
	}

	.foot {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--s-4);
		flex-wrap: wrap;
		margin-top: var(--s-6);
	}

	.reach {
		display: flex;
		align-items: center;
		gap: var(--s-4);
		flex-wrap: wrap;
	}

	.resume {
		font-family: var(--font-geist-mono);
		font-size: var(--t-xs);
		letter-spacing: 0.02em;
		text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
	}

	@media (hover: hover) {
		.resume:hover {
			text-decoration-color: var(--accent);
	
		}
	}

	.contacts {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--s-2) var(--s-6);
	}

	.contacts {
		gap: var(--s-4);
	}

	.contacts a {
		display: block;
		color: var(--accent);
		line-height: 0;
		padding: var(--s-1);
		margin: calc(-1 * var(--s-1));
		transition: color 120ms ease-out;
	}

	@media (hover: hover) {
		.contacts a:hover {
			color: color-mix(in srgb, var(--accent) 72%, #000);
	
		}
	}

	/* The address is set, not drawn, so it needs the line-height the glyphs
	   gave up, and the mono of every other literal value on the sheet. */
	.contacts a.as-text {
		font-family: var(--font-geist-mono);
		font-size: var(--t-xs);
		letter-spacing: 0.02em;
		line-height: 1;
		text-decoration: underline;
		text-underline-offset: 0.25em;
		text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
	}

	@media (hover: hover) {
		.contacts a.as-text:hover {
			text-decoration-color: var(--accent);
	
		}
	}

	.stamp {
		margin: 0;
		font-family: var(--font-geist-mono);
		font-size: var(--t-xs);
		font-variant-numeric: tabular-nums;
		color: var(--accent);
		white-space: nowrap;
	}


	@media (prefers-reduced-motion: reduce) {
		.caret {
			animation: none;
		}
	}

	/* --- Features --- */
	.features {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.features li {
		display: flex;
		flex-direction: column;
		gap: var(--s-1);
		padding: var(--s-3) var(--s-2);
		margin-inline: calc(-1 * var(--s-2));
		border-radius: 2px;
		transition: background-color 120ms ease-out;
	}

	@media (hover: hover) {
		.features li:hover {
			background: var(--wash);
		}
	}

	/* Three tiers, and every one of them a step the scale already has:
	   28px, 20px, 16px. There is nothing between 20 and 28 to reach for,
	   so the second tier is made by dropping the tail to 16 rather than by
	   inventing a 24. The tail is body size, which is the floor a list of
	   facts should sit at, not below it.

	   Keyed to position, like the project list's descent, so reordering
	   `CREDENTIALS` reorders the emphasis with it. A rank written into the
	   data is a number somebody has to remember to move, and the one thing
	   this page does everywhere else is derive the numbering. */
	.feature-text {
		font-size: var(--t-base);
		line-height: 1.45;
	}

	/* Second tier. Engineering physics leads because a reader outside the
	   field does not know what it is and it carries the sources that say;
	   the NOI placing is the strongest fact on the page and sits directly
	   under it, a step down but clear of everything below. */
	.features li:nth-child(2) .feature-text {
		font-size: var(--t-md);
		line-height: 1.35;
		letter-spacing: -0.01em;
	}

	/* Lead. The list is ordered most-impressive-first, so this entry is the
	   hook PRODUCT.md names. It was set identically to the last credential;
	   the project list has carried graded legibility all along and this one
	   never got it. */
	.features li:first-child .feature-text {
		font-size: var(--t-lg);
		line-height: 1.2;
		letter-spacing: -0.02em;
	}

	/* Underlined at rest on every pointer type, at 45% accent, the treatment
	   `.resume` already uses. This was a 0%-to-100% gradient sweep that only
	   existed inside `@media (hover: hover)`, so a phone drew every underline
	   and a laptop drew none: five credential titles and seven project titles
	   were plain black text with no cue at all. Clicking through to verify is
	   the conversion this page is for, and on a recruiter's laptop it was the
	   least visible thing in the row.

	   Hover now confirms rather than discovers, which is the right job for it.
	   The sweep is gone: it animated 260ms against a doctrine that allows
	   120ms colour and underline changes, and it was invisible to the half of
	   readers who most needed the cue. */
	.feature-text a {
		color: var(--ink);
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
		transition:
			text-decoration-color 160ms ease-out,
			color 160ms ease-out;
	}

	@media (hover: hover) {
		.feature-text a:hover {
			color: var(--accent);
			text-decoration-color: var(--accent);
		}
	}

	/* Outside the hover query on purpose. Keyboard focus has nothing to do
	   with whether the device has a pointer, and nesting it in `hover: hover`
	   dropped this treatment for anyone tabbing on a touch device with a
	   keyboard. The global 2px outline still fired, so it was never
	   invisible, only inconsistent. */
	.feature-text a:focus-visible {
		color: var(--accent);
		text-decoration-color: var(--accent);
	}

	/* An unconfirmed credential is knocked back to the tail size and muted
	   whatever position it holds, so a fact still being checked cannot lead
	   the section. Same specificity as the two tier rules above and it
	   comes after them on purpose; moving it earlier silently lets an
	   unconfirmed entry render at 28px. Dormant today, every credential is
	   confirmed. */
	.features li.unconfirmed .feature-text {
		font-size: var(--t-base);
		line-height: 1.45;
		letter-spacing: normal;
		color: var(--muted);
	}

	/* Muted. The note was briefly accent and it inverted the page's own
	   colour rule: seven red notes that are not links, sitting directly under
	   five credential titles that are. A reader learns "red means clickable"
	   from the nav and the contact row, and §1 was teaching the opposite.

	   The disclosure arrow keeps the accent, so a foldable credential still
	   announces itself; that mark IS a control, which is the distinction the
	   note failed. */
	.feature-note {
		font-size: var(--t-xs);
		color: var(--muted);
	}

	/* Somebody else's words under a credential, folded away until asked for.
	   Several lines of quotation outweigh the credential they support, so
	   the evidence is available rather than spent: the reader sees an arrow
	   and opens it only if the claim needs settling.

	   The note itself is the control, with the arrow after it, so the
	   disclosure costs no extra line and the target is a whole line of text
	   rather than a glyph.

	   `<details>` is the entire mechanism. No script, so it works with
	   scripts blocked, and because it opens only on user input it sits
	   inside the "nothing moves without user input" rule rather than beside
	   it as another exception. */
	.feature-source summary {
		display: block;
		width: fit-content;
		cursor: pointer;
		/* Padding for the touch target, negative margin to give back the
		   space, so the note sits exactly where it does without a
		   disclosure and the two kinds of credential still line up. */
		padding-block: var(--s-2);
		margin-block: calc(-1 * var(--s-2));
		/* Firefox, and modern Chrome. */
		list-style: none;
	}

	/* Safari, and Chrome before it honoured `list-style` here. */
	.feature-source summary::-webkit-details-marker {
		display: none;
	}

	/* Drawn rather than the platform triangle, and swapped rather than
	   rotated: a glyph change needs no motion to read as a state change. */
	.feature-source summary::after {
		content: '\25B8';
		margin-left: 0.45em;
		color: var(--accent);
	}

	.feature-source[open] summary::after {
		content: '\25BE';
	}

	@media (hover: hover) {
		.feature-source summary:hover .feature-note {
			color: var(--ink);
		}
	}

	/* The rule down the left is what marks the block as quoted rather than
	   as a second note; it and the note both sit at 14px in the muted
	   colour, so without it they would read as one run-on line. */
	.feature-source blockquote {
		margin: var(--s-3) 0 0 0;
		padding-left: var(--s-3);
		border-left: var(--hairline) solid var(--rule);
		max-width: 62ch;
	}

	.feature-source blockquote p {
		margin: 0;
		font-size: var(--t-xs);
		line-height: 1.5;
		color: var(--muted);
		text-wrap: pretty;
	}

	.feature-source cite {
		display: block;
		margin-top: var(--s-1);
		font-size: var(--t-xs);
		font-style: normal;
	}

	/* --- Projects. Graded legibility: the list compresses downward. --- */
	.projects {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	/* One column at every width. The figure used to be a second column
	   floated beside the text, which put it *after* the summary, parameters
	   and links in source order, so on a phone, where the row collapses to
	   one column, the picture landed at the bottom of the block it was there
	   to introduce. It now follows the title directly: name, artifact,
	   details. That is also the order a screen reader announces. */
	/* 24px, not 48. `.section` has `padding-block: var(--s-6)`, so two
	   sections sit 96px apart; at --s-6 here two rows inside one list sat
	   96px apart too, and §3 stopped reading as a list of eight things and
	   started reading as eight loose sections. A row is a smaller break than
	   a section, so it gets a smaller gap. Shortening the summaries made the
	   old value worse: less text, same air. */
	.project {
		padding: var(--s-4) var(--s-2);
