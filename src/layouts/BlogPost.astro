---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import TagList from '../components/TagList.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} noindex={noindex} />
	</head>

	<body>
		<Header />
		<main class="sheet">
			<article>
				<header class="masthead">
					<p class="back"><a href="/blog">← All posts</a></p>
					<h1>{title}</h1>
					<p class="description">{description}</p>
					<dl class="meta">
						<div>
							<dt class="legend">Published</dt>
							<dd><FormattedDate date={pubDate} /></dd>
						</div>
						{
							updatedDate && (
								<div>
									<dt class="legend">Revised</dt>
									<dd>
										<FormattedDate date={updatedDate} />
									</dd>
								</div>
							)
						}
					</dl>
					<div class="post-tags">
						<TagList tags={tags} label="Tags for this post" />
					</div>
				</header>

				{
					heroImage && (
						<figure class="hero">
							<Image width={1440} height={720} src={heroImage} alt="" />
							<figcaption>
								<span class="designator">Fig. 1</span> {title}
							</figcaption>
						</figure>
					)
				}

				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.masthead {
		padding-block: var(--s-6) var(--s-5);
		max-width: var(--measure);
	}

	.back {
		margin: 0 0 var(--s-4) 0;
		font-family: var(--font-geist-mono);
		font-size: var(--t-xs);
	}

	.back a {
		text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
	}

	@media (hover: hover) {
		.back a:hover {
			text-decoration-color: var(--accent);
	
		}
	}

	.description {
		font-size: var(--t-md);
		line-height: 1.45;
		color: var(--muted);
		margin: var(--s-3) 0 0 0;
		text-wrap: balance;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-2) var(--s-6);
		margin: var(--s-5) 0 0 0;
		font-variant-numeric: tabular-nums;
	}

	.meta div {
		display: flex;
		flex-direction: column;
		gap: var(--s-1);
	}

	.meta dd {
		margin: 0;
		font-size: var(--t-xs);
	}

	.post-tags {
		margin-top: var(--s-3);
	}

	.hero {
		margin: 0 0 var(--s-6) 0;
	}

	.hero img {
		display: block;
		width: 100%;
		height: auto;
		border: var(--hairline) solid var(--rule);
	}

	.hero figcaption {
		margin-top: var(--s-2);
		font-size: var(--t-xs);
		color: var(--muted);
	}

	.prose {
		max-width: var(--measure);
		padding-bottom: var(--s-6);
	}

	/* Ink, not accent. The accent was tried here on 4 Sep and taken back
	   out the same day; see DESIGN.md. A heading does not need colour to
	   read as a heading, and the site keeps red for links. */
	.prose :global(h2) {
		font-size: var(--t-md);
		margin-top: var(--s-6);
		margin-bottom: var(--s-3);
	}

	.prose :global(h3) {
		font-size: var(--t-base);
		margin-top: var(--s-5);
		margin-bottom: var(--s-2);
	}

	.prose :global(p) {
		margin-block: 0 var(--s-4);
	}

	.prose :global(ul),
	.prose :global(ol) {
		margin-block: 0 var(--s-4);
		padding-left: var(--s-4);
	}

	.prose :global(li) {
		margin-bottom: var(--s-2);
	}

	.prose :global(img) {
		max-width: 100%;
		height: auto;
		border: var(--hairline) solid var(--rule);
	}

	.prose :global(blockquote) {
		margin: 0 0 var(--s-4) 0;
		padding-left: var(--s-4);
		border-left: var(--hairline) solid var(--rule-strong);
		color: var(--muted);
	}

	.prose :global(hr) {
		border: 0;
		border-top: var(--hairline) solid var(--rule);
		margin-block: var(--s-6);
	}

	.prose :global(code) {
		font-size: var(--t-xs);
		background: var(--wash);
		padding: 0.1em 0.3em;
		border-radius: 2px;
	}

	.prose :global(pre) {
		background: var(--wash);
		border: var(--hairline) solid var(--rule);
		padding: var(--s-3);
		overflow-x: auto;
		font-size: var(--t-xs);
		margin-block: 0 var(--s-4);
	}

	.prose :global(pre code) {
		background: none;
		padding: 0;
	}

	.prose :global(table) {
		/* Block-level so an over-wide table scrolls inside the measure
		   instead of pushing the whole page sideways. */
		display: block;
		overflow-x: auto;
		max-width: 100%;
		width: 100%;
		border-collapse: collapse;
		font-size: var(--t-xs);
		font-variant-numeric: tabular-nums;
		margin-block: 0 var(--s-4);
	}

	.prose :global(th),
	.prose :global(td) {
		text-align: left;
		padding: var(--s-2) var(--s-3) var(--s-2) 0;
		border-bottom: var(--hairline) solid var(--rule);
	}

	@media (max-width: 40rem) {
		.masthead {
			padding-block: var(--s-6) var(--s-4);
		}
	}
</style>
