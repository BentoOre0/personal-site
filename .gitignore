# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# local agent settings
.claude/settings.local.json
# vendored agent skills: reinstallable from skills-lock.json, so the bodies
# are not worth versioning. Ignore all of them and re-admit the project's
# own design rules, which are ours and ARE tracked.
.claude/skills/*
!.claude/skills/design/
# same skills, mirrored by the agent runtime
.agents/

# impeccable working state (live/ config is kept as project config)
.impeccable/config.local.json
.impeccable/questions/
.impeccable/live/sessions/
.impeccable/live/annotations/
.impeccable/live/roots.json

# design screenshots
.shots/
